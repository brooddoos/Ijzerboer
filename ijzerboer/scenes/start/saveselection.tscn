[node name="Title" type="Label" parent="tutorial"]
layout_mode = 2
theme_override_font_sizes/font_size = 50
text = "Tutorial:"
horizontal_alignment = 1

[node name="begin" type="Label" parent="tutorial"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "The ingame tutorials arent't finished, enjoy this written tutorial 
(press next to continue)"
horizontal_alignment = 1
autowrap_mode = 2

[node name="controls" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "These are the basic controls used in-game:
[b]␣[/b] to drive
[b]Ｌ[/b] to toggle headlights and [b]Ｈ[/b] to honk
[b]␤[/b] to switch between camera positions
[b]␫[/b] to switch between tapes and [b]～[/b] (or whatever is left of the one key on your keyboard) to view the tape
[b]␩[/b] or [b]␺[/b] to drift
[b]␯[/b] to open pause menu"
horizontal_alignment = 1
vertical_alignment = 1

[node name="goal" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "Well, what's the goal of this game? 
The quest system hasn't been implemented yet, but the basic premise is that you collect scrap metal and sell it for cash. 
You can use this money to upgrade your car! 
Also, since not all models are finished at the moment, some are temporarily replaced with balls or cubes."
horizontal_alignment = 1
vertical_alignment = 1

[node name="upgrades" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "Wait, car upgrades?
Yes! You can upgrade your car at the local garage, this can  include stuff like making your car faster, or having a higher load capacity, to upgrading your GPS to show scrap metal!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="location" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "Well, I don't know where everything is!
Well, drive around! You have a small GPS showing where you are on the map, but if you wanna see where the different locations are you should explore."
horizontal_alignment = 1
vertical_alignment = 1


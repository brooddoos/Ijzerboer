[node name="plans" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 25
bbcode_enabled = true
text = "[This tutorial item will only be included with the beta releases]
What are your future plans for this game?
We are currently working on:
- A custscene system
- A quest system
- An achievement system
- Improving general UI & UX + the map
- Two new gamemodes (Rally + free roam)
And finally controller support."
horizontal_alignment = 1
vertical_alignment = 1

[node name="plans2" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "
We have lives outside of making this game, so we don't have a definitive ETA on when these features will be finished."
horizontal_alignment = 1
vertical_alignment = 1

[node name="final" type="RichTextLabel" parent="tutorial"]
visible = false
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
theme_override_fonts/bold_font = ExtResource("4_eb7q4")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 40
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "Well, that's it basically, you can press \"Start Game\" now to well, start the game."
horizontal_alignment = 1
vertical_alignment = 1

